# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# MEDIA_DIR=/data/media
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://watchy.example.com

# Users: username:bcryptHash[:admin|:user]
# Generate: npm run hash-password -- 'votre-mot-de-passe'
# For Docker Compose, escape bcrypt $ as $$ (bootstrap-vps.sh does this automatically)
AUTH_USERS=alice:REPLACE:admin,bob:REPLACE:user

# The Movie Database — free key for auto posters/titles (Jellyfin-style)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OpenSubtitles — recherche de sous-titres par hash de fichier (optionnel)
# Sans clé, la fonctionnalité se désactive proprement, le reste marche.
# Clé gratuite : https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
